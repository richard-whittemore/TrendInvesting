[Unit]
Description=Reporter for account %i: alerts, their repeats and the daily summary
# No Condition: a missing binary, a run.env naming a log that is missing or an
# empty secret fails the unit with a message, so the owner sees a failed unit,
# never a silent skip (docs/manual/alerts-and-dashboard.md, "What can go wrong").
# When this unit fails, ti-unit-failed@%n sends one urgent page through the
# reporter's channels naming it, the failed run's last journal line and the
# manual row to read (ADR 0019, "Alerting"; docs/manual/server.md, "A failed
# unit").
OnFailure=ti-unit-failed@%n.service
# The secrets rest on disk only encrypted; ti-unlock decrypts them after
# each boot into a root-only tmpfs, and this unit loads its credential
# from there. Until then systemd refuses to start it ("Assertion failed")
# (ADR 0028; docs/manual/server.md, "Unlocking the
# secrets after a boot").
AssertPathExists=/run/trend-investing/secrets/secrets.env

[Service]
Type=oneshot
# Stopped well before the timer's next firing (ti-reporter@.timer, every 5
# minutes), which systemd would otherwise skip while this run is active. The
# reporter saves each delivery to its state file as a channel takes it, so a
# run stopped here makes the next one send again at most the one alert on the
# one channel that had taken it but was not yet saved (at-least-once:
# ntfy and Pushover each post it twice).
TimeoutStartSec=4min
User=ti-trader
Group=ti-trader
Environment=TZ=America/New_York
Environment=TI_STATE_DIR=/var/lib/trend-investing/engines/%i
Environment=TI_REPORTS_DIR=/var/lib/trend-investing/reports
# TI_RUN: the engine's current run, whose durable log is read. systemd reads
# the file again at every start, so after a fresh run the next firing follows
# the new log. Optional here ("-") because before the account's first run there is
# none, and -run-env below makes that a quiet wait.
EnvironmentFile=-/var/lib/trend-investing/engines/%i/run.env
# TI_NTFY_TOPIC, TI_NTFY_SERVER, TI_PUSHOVER_APP_TOKEN,
# TI_PUSHOVER_USER_KEY and TI_HEARTBEAT_URL, read from %d/secrets and never printed. A firing that
# finishes without a fault pings TI_HEARTBEAT_URL, the outside service that
# pages the owner when the pings stop (docs/manual/server.md, "The outside
# heartbeat").
LoadCredential=secrets:/run/trend-investing/secrets/secrets.env
# The clock check is run at every firing, after the incident alerts: two
# failing checks in a row page once for the whole host, a passing check
# resolves it, and the daily summary shows the last check (ADR 0019,
# "Alerting"; docs/manual/server.md, "The clock"). Installed by provision.sh
# clock. The clock is the host's, so every instance shares one clock state,
# host-clock.json in the reports directory, under a lock.
# The state file of delivered alerts is per account, so it outlives a run:
# an alert already delivered is not sent again from a later run's log.
# The Flex reader's ledger of the account's deposits and withdrawals
# (ti-flex@%i) is read for the daily summary's SPY shadow account; until the
# reader has written it the summary says the comparison assumes none.
# -units: the instance's engine and adapter, asked of systemd (systemctl
# show: state and invocation) once at the start of every firing: a failed one
# is named in the state-at-start page, its failed run is paged if the
# OnFailure hook did not page it (once per failure episode), and the page of a
# unit no longer failed is resolved. The reporter reads the failed run's journal lines, so it is in the
# journal group. -self-unit: a clean firing resolves the page of an earlier
# failed one.
# -run-env: while the engine's run.env is missing or empty and nothing shows a
# run (no <account>.ran marker in the reports directory, no *.log in the engine
# folder), the firing logs that it is waiting for the account's first run and skips
# only the reading of the journal; every other step runs as usual. With any
# sign of a run it is an alert and a fault (docs/manual/server.md, "The reporter before the
# first run").
SupplementaryGroups=systemd-journal
ExecStart=/opt/trend-investing/bin/ti-reporter -run-env /var/lib/trend-investing/engines/%i/run.env -journal ${TI_STATE_DIR}/${TI_RUN}.log -state ${TI_REPORTS_DIR}/%i.reporter.json -secrets-file %d/secrets -channel ntfy,pushover,github-issues -summary -account %i -clock-check /usr/local/libexec/trend-investing/clock-check.sh -clock-state ${TI_REPORTS_DIR}/host-clock.json -cash-ledger /var/lib/trend-investing/flex/%i/cash-movements.jsonl -units ti-engine@%i.service,ti-adapter-%i.service -self-unit ti-reporter@%i.service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trend-investing/reports
ReadOnlyPaths=/var/lib/trend-investing/engines
# No instruction can come from this unit: it runs as ti-trader, the engine's
# user, and reads data from outside, so the operator inboxes are hidden from
# it, and nothing under the engines' state is writable (ProtectSystem=strict;
# ADR 0026, kill-switch amendment; docs/manual/server.md).
InaccessiblePaths=-/var/lib/trend-investing/engines/boost/operator -/var/lib/trend-investing/engines/trad-ira/operator -/var/lib/trend-investing/engines/roth-ira/operator
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
