[Unit]
Description=Loopback-only access to the Gateway API ports
After=network-pre.target
# Gateway startup requires this guard (docs/manual/server.md,
# "The server's own guard on the Gateway's ports"). Stopping keeps the rules.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables/ti-gateway-guard.nft

[Install]
WantedBy=multi-user.target
