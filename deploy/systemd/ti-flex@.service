[Unit]
Description=Flex reader for account %i: IBKR's Cash Transactions, each new deposit or withdrawal into its cash ledger and each commission, fee and interest posting into its costs ledger, and the executions proof from its Trade Confirmations
# One instance per account: ti-flex@boost, ti-flex@trad-ira, ti-flex@roth-ira.
# IBKR's Flex Web Service only: the reader needs the network, not IB Gateway,
# and nothing else depends on it (the engine, the adapter and the trading
# loop never read its ledger).
After=network-online.target
Wants=network-online.target
# Skipped, not failed, until the adapter's code is installed (provision.sh
# adapter), as ti-adapter-boost.service is. Once installed, a missing token,
# a rejected one, an account file with its line not filled in, a statement
# refused or a service error fails the unit with a message, so the owner sees
# a failed unit, never a silent skip (docs/manual/reconciliation.md,
# "Deposits and withdrawals, read from IBKR"). provision.sh writes every
# account's file, named only, so the reader is the one to say which line is
# empty; an account file deleted after that is refused at the start, naming
# its unlocked copy (the AssertPathExists= lines below).
ConditionFileIsExecutable=/opt/trend-investing/adapter-venv/bin/python3
ConditionPathExists=/opt/trend-investing/adapter/adapter/ibkr/flex.py
# The secrets rest on disk only encrypted; ti-unlock decrypts them after
# each boot into a root-only tmpfs, and this unit loads its credential
# from there. Until then systemd refuses to start it ("Assertion failed")
# (ADR 0028; docs/manual/server.md, "Unlocking the
# secrets after a boot").
AssertPathExists=/run/trend-investing/secrets/secrets.env
AssertPathExists=/run/trend-investing/secrets/accounts/%i.env

[Service]
Type=oneshot
# Above the reader's worst case: for each of its two queries (the cash
# query and the trades query), SendRequest and 30 GetStatement attempts,
# each to its 60-second request timeout, the 29 waits of 10 seconds between
# them, and up to three answers of IBKR's 1018 (too many requests) asked
# again after 10, 30 and 60 seconds (flex.REQUEST_TIMEOUT,
# GENERATION_ATTEMPTS, GENERATION_WAIT, RATE_BACKOFF; about 41 minutes a
# query, 82 in all with the gap between them), with the wait for the Flex
# token (at most 4 minutes while another account's reader holds it, on
# /var/lib/trend-investing/flex, read only) and the minute its holder waits
# before its first request (flex.TOKEN_LOCK_WAIT, TOKEN_COOLDOWN): about 87
# minutes. A firing of the timer while a reading
# still runs starts nothing. A reading that hangs past this is stopped and shows as
# failed rather than staying "activating"; its status file then still says
# "running" with the time it began, never the previous reading's "read".
TimeoutStartSec=90min
User=ti-trader
Group=ti-trader
Environment=TZ=America/New_York
# TI_RUN: the account's engine's current run, whose durable log (and the runs
# before it, through the Run approvals) gives the first run's approval time
# and the net liquidation before each transfer. Optional here ("-") so that
# its absence reaches the check below.
EnvironmentFile=-/var/lib/trend-investing/engines/%i/run.env
ExecStartPre=/bin/sh -c 'test -s /var/lib/trend-investing/engines/%i/run.env || { echo "ti-flex@%i: /var/lib/trend-investing/engines/%i/run.env is missing or empty: start the %i engine once first (its durable log gives the equity before each transfer)" >&2; exit 1; }'
# TI_IBKR_FLEX_TOKEN, TI_IBKR_FLEX_QUERY_ID and TI_IBKR_FLEX_TRADES_QUERY_ID (optional) from %d/secrets, and the
# account's number from %d/account (IBKR_ACCOUNT_BOOST in accounts/boost.env,
# IBKR_ACCOUNT_TRAD_IRA in accounts/trad-ira.env, ...): read, never printed.
# The token is sent to IBKR's Flex Web Service only.
LoadCredential=secrets:/run/trend-investing/secrets/secrets.env
LoadCredential=account:/run/trend-investing/secrets/accounts/%i.env
WorkingDirectory=/opt/trend-investing/adapter
ExecStart=/opt/trend-investing/adapter-venv/bin/python3 -m adapter.ibkr flex --secrets %d/secrets --account-secrets %d/account --instance %i --engine-log /var/lib/trend-investing/engines/%i/${TI_RUN}.log --ledger /var/lib/trend-investing/flex/%i/cash-movements.jsonl
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Its cash ledger, its costs ledger (costs.jsonl) and its executions proof
# (executions.json, read by the adapter), in the same folder, and
# beside them the status, coverage, resolutions and lock files and the .tmp
# each whole-file write renames over its file, and nothing else.
ReadWritePaths=/var/lib/trend-investing/flex/%i
ReadOnlyPaths=/var/lib/trend-investing/engines/%i
# No instruction can come from this unit: it runs as ti-trader, the engine's
# user, and reads data from outside, so the operator inboxes are hidden from
# it, and nothing under the engines' state is writable (ProtectSystem=strict;
# ADR 0026, kill-switch amendment; docs/manual/server.md).
InaccessiblePaths=-/var/lib/trend-investing/engines/boost/operator -/var/lib/trend-investing/engines/trad-ira/operator -/var/lib/trend-investing/engines/roth-ira/operator
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
