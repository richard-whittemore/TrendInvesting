[Unit]
Description=Page the owner that %i failed
# Started by OnFailure= on the engine, the adapter and the reporter, with the
# failed unit's name as the instance (for the engine,
# ti-unit-failed@ti-engine@boost.service.service, whose %i is
# ti-engine@boost.service; the rehearsal starts it under systemd). systemd
# hands it the failed run's invocation ID (MONITOR_INVOCATION_ID); the page is
# keyed by the run that began the failure episode, so one failure pages once,
# a later failed run before the unit is seen well only counts toward an
# hourly reminder, and the episode's incident is resolved when a firing of
# the reporter sees the unit well. It sends one urgent page through
# the reporter's channels (PagerDuty and the owner's own ntfy) naming the
# unit, the failed run's last journal line and the manual row to read; a
# firing of the reporter pages a failure this unit could not deliver (ADR
# 0019, "Alerting"; docs/manual/server.md, "A failed unit"). No Condition: a
# missing binary fails this unit with a message, so the owner sees a failed
# unit, never a silent skip.
# The secrets rest on disk only encrypted; ti-unlock decrypts them after
# each boot into a root-only tmpfs, and this unit loads its credential
# from there. Until then systemd refuses to start it ("Assertion failed")
# (ADR 0028; docs/manual/server.md, "Unlocking the
# secrets after a boot").
AssertPathExists=/run/trend-investing/secrets/secrets.env

[Service]
Type=oneshot
# Each send is bounded at 30 seconds and the journal read at 15, so a hung
# channel ends this unit rather than leaving it activating.
TimeoutStartSec=2min
User=ti-trader
Group=ti-trader
# The failed run's last journal line, or systemd's line about it, is the
# page's reason.
SupplementaryGroups=systemd-journal
Environment=TZ=America/New_York
# TI_NTFY_TOPIC, TI_NTFY_SERVER and TI_PAGERDUTY_ROUTING_KEY from %d/secrets,
# never printed; the same credential file the reporter reads.
LoadCredential=secrets:/run/trend-investing/secrets/secrets.env
# The record of failed-unit pages is the host's, beside the reporters' state
# files: the reporter's firings read it to resolve a page and to skip a unit
# already paged.
ExecStart=/opt/trend-investing/bin/ti-reporter notify-unit-failed -state /var/lib/trend-investing/reports/unit-failures.json -secrets-file %d/secrets -channel ntfy,pagerduty %i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trend-investing/reports
# No instruction can come from this unit: it runs as ti-trader, the engine's
# user, and reaches the network, so the operator inboxes are hidden from it
# (ProtectSystem=strict; ADR 0026, kill-switch amendment; docs/manual/server.md).
InaccessiblePaths=-/var/lib/trend-investing/engines/boost/operator -/var/lib/trend-investing/engines/trad-ira/operator -/var/lib/trend-investing/engines/roth-ira/operator
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
