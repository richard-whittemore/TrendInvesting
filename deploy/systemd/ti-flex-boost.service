[Unit]
Description=Flex reader for the Boost account: IBKR's Cash Transactions, each new deposit or withdrawal into its ledger
# IBKR's Flex Web Service only: the reader needs the network, not IB Gateway,
# and nothing else depends on it (the engine, the adapter and the trading
# loop never read its ledger).
After=network-online.target
Wants=network-online.target
# Skipped, not failed, until the adapter's code is installed (provision.sh
# adapter), as ti-adapter-boost.service is. Once installed, a missing token,
# a rejected one, a statement refused or a service error fails the unit with
# a message, so the owner sees a failed unit, never a silent skip
# (docs/manual/reconciliation.md, "Deposits and withdrawals, read from IBKR").
ConditionFileIsExecutable=/opt/trend-investing/adapter-venv/bin/python3
ConditionPathExists=/opt/trend-investing/adapter/adapter/ibkr/flex.py

[Service]
Type=oneshot
# One reading asks IBKR for the statement and waits up to 5 minutes while
# IBKR generates it (flex.GENERATION_WAIT x GENERATION_ATTEMPTS), each
# request bounded at 60 seconds; a run that hangs past this is stopped and
# shows as failed rather than staying "activating".
TimeoutStartSec=15min
User=ti-trader
Group=ti-trader
Environment=TZ=America/New_York
# TI_RUN: the Boost engine's current run, whose durable log (and the runs
# before it, through the Run approvals) gives the net liquidation before each
# transfer. Optional here ("-") so that its absence reaches the check below.
EnvironmentFile=-/var/lib/trend-investing/engines/boost/run.env
ExecStartPre=/bin/sh -c 'test -s /var/lib/trend-investing/engines/boost/run.env || { echo "ti-flex-boost: /var/lib/trend-investing/engines/boost/run.env is missing or empty: start the Boost engine once first (its durable log gives the equity before each transfer)" >&2; exit 1; }'
# TI_IBKR_FLEX_TOKEN and TI_IBKR_FLEX_QUERY_ID from %d/secrets, and the
# Boost account's number from %d/account: read, never printed. The token is
# sent to IBKR's Flex Web Service only.
LoadCredential=secrets:/etc/trend-investing/secrets.env
LoadCredential=account:/etc/trend-investing/accounts/boost.env
WorkingDirectory=/opt/trend-investing/adapter
ExecStart=/opt/trend-investing/adapter-venv/bin/python3 -m adapter.ibkr flex --secrets %d/secrets --account-secrets %d/account --account-key IBKR_ACCOUNT_BOOST --engine-log /var/lib/trend-investing/engines/boost/${TI_RUN}.log --ledger /var/lib/trend-investing/flex/boost/cash-movements.jsonl
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Its ledger, the ledger's status file and lock, and nothing else.
ReadWritePaths=/var/lib/trend-investing/flex/boost
ReadOnlyPaths=/var/lib/trend-investing/engines/boost
# No instruction can come from this unit: it runs as ti-trader, the engine's
# user, and reads data from outside, so the operator inboxes are hidden from
# it, and nothing under the engines' state is writable (ProtectSystem=strict;
# ADR 0026, kill-switch amendment; docs/manual/server.md).
InaccessiblePaths=-/var/lib/trend-investing/engines/boost/operator -/var/lib/trend-investing/engines/trad-ira/operator -/var/lib/trend-investing/engines/roth-ira/operator
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
