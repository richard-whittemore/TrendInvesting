[Unit]
Description=IB Gateway under IBC (one gateway for all three engines)
Documentation=https://github.com/IbcAlpha/IBC
After=network-online.target
Wants=network-online.target
# The secrets rest on disk only encrypted; ti-unlock decrypts them after
# each boot into a root-only tmpfs, and this unit loads its credential
# from there. Until then systemd refuses to start it ("Assertion failed")
# (ADR 0028; docs/manual/server.md, "Unlocking the
# secrets after a boot").
AssertPathExists=/run/trend-investing/secrets/ibkr-login.env

[Service]
Type=simple
User=ti-gateway
Group=ti-gateway
Environment=TZ=America/New_York
EnvironmentFile=/etc/trend-investing/gateway.env
# The unlocked login file is root-only, in memory; systemd hands this service
# one private copy.
LoadCredential=ibkr-login:/run/trend-investing/secrets/ibkr-login.env
RuntimeDirectory=ti-gateway
RuntimeDirectoryMode=0700
LogsDirectory=ti-gateway
StateDirectory=ti-gateway
# Renders IBC's config.ini, then starts the gateway (see the script for why
# the render is not an ExecStartPre).
ExecStart=/usr/local/libexec/trend-investing/start-gateway.sh
# IBC exits non-zero when the weekly second factor times out; start again so
# the next phone prompt arrives rather than leaving the gateway down.
Restart=always
RestartSec=30
# Except on the renderer's configuration exits: 78 = the login file is not
# filled in yet (owner step), 64 = it holds an unknown key or value, 65 = the
# IBC template lacks a key; and 77 = the bound on login attempts is reached
# (ti-gateway-start, cmd/gateway-start, which start-gateway.sh runs), where
# another try risks IBKR locking the login. None
# fixes itself, so do not loop on them. 75 (one refused login) restarts.
RestartPreventExitStatus=64 65 77 78
# Bound submitted healer jobs in systemd (docs/manual/server.md, Gateway healer).
TimeoutStartSec=90
TimeoutStopSec=60
# ti-gateway-start stops only xvfb-run, its own child, after a refused login;
# this default, stated so it cannot be dropped, is what ends IBC's java and
# Xvfb when the program exits, so the next start finds no stale Gateway.
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ti-gateway /var/log/ti-gateway
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
