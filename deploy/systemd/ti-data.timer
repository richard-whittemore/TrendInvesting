[Unit]
Description=Run the market-data step after the US close on weekdays

[Timer]
# 17:05, 18:05 and 20:05 New York (systemd's form: 17,18,20:05), each
# after the close (4 p.m.) plus the 60 settle minutes the service passes
# ti-data (--settle-minutes), so the day's session has settled when it runs;
# adapter/marketdata/tests/test_tidata.py checks every firing against every
# session. The later firings retry the same evening after a failure (a
# Massive outage, a 429 streak); once the day's file exists they find it and
# fetch nothing. Persistent: a run missed while the server was down runs at
# boot, and catches up every session since the last stream.
OnCalendar=Mon..Fri 17,18,20:05 America/New_York
Persistent=true
Unit=ti-data.service

[Install]
WantedBy=timers.target
