[Unit]
Description=Run the market-data step after the US close on weekdays

[Timer]
# 17:05 New York: after the close (4 p.m.) plus the 60 settle minutes the
# service passes ti-data (--settle-minutes), so the day's session has
# settled when it runs; adapter/marketdata/tests/test_tidata.py checks that
# the two agree for every session. Persistent: a run missed while the server
# was down runs at boot, and catches up every session since the last stream.
OnCalendar=Mon..Fri 17:05 America/New_York
Persistent=true
Unit=ti-data.service

[Install]
WantedBy=timers.target
