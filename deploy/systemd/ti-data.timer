[Unit]
Description=Run the market-data step on weekday mornings, for the previous session

[Timer]
# 06:05, 07:05 and 08:05 New York on weekdays (systemd's form: 6,7,8:05).
# Massive's free plan serves a session's grouped bars only the next morning
# (a 403 before then), so each firing records the previous session: Tuesday
# to Friday read the day before, Monday reads Friday, and the morning after a
# holiday reads the session before it (adapter/marketdata/tests/test_tidata.py
# checks every firing against every session). All three are before the 9:30
# open; the adapter's morning reading stands for the session's close with the
# Flex reader's executions proof (ti-flex@.timer, 05:30, 06:30 and 07:30;
# ADR 0019, amended 2026-10-27), else the session is withheld
# (docs/manual/market-data.md, "The free plan's timing"). A
# 403 at the first two firings is a quiet wait; one that persists at the last
# is a failure that pages (ti-data.service; docs/manual/market-data.md, "The
# free plan's timing"). Once the session's file exists a later firing finds it
# and fetches nothing. Persistent: a run missed while the server was down runs
# at boot, and catches up every session since the last stream.
OnCalendar=Mon..Fri 6,7,8:05 America/New_York
Persistent=true
Unit=ti-data.service

[Install]
WantedBy=timers.target
