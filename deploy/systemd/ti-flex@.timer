[Unit]
Description=Run the Flex reader for account %i each weekday morning, before the data job

[Timer]
# 05:30, 06:30 and 07:30 New York, weekdays: each before one of the data
# job's firings (ti-data.timer: 06:05, 07:05, 08:05). The morning delivery
# of the session before stands for its close only with the executions proof
# this reading writes (ADR 0019, amended 2026-10-27;
# docs/manual/reconciliation.md, "The executions proof"), and the adapter
# waits for it until 09:00. IBKR's Activity statements are refreshed once a
# day at close of business and its Trade Confirmation reports within 5 to 10
# minutes of an execution (IBKR, Flex Web Service), so a morning reading
# holds the day before; a later firing reads again, which writes nothing
# twice: the owner's cash query covers the last 30 days, a statement that
# leaves a day unread since the last reading is refused as a coverage gap,
# and a transfer already in the ledger is never written again. Persistent: a
# run missed while the server was down runs at boot. Enabled per account by
# the owner once the token and query IDs are in secrets.env and the account's
# file is in accounts/ (docs/runbooks/lightsail-deployment.md, "The Flex
# reader").
OnCalendar=Mon..Fri 05:30 America/New_York
OnCalendar=Mon..Fri 06:30 America/New_York
OnCalendar=Mon..Fri 07:30 America/New_York
Persistent=true
Unit=ti-flex@%i.service

[Install]
WantedBy=timers.target
