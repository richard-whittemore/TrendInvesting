[Unit]
Description=Trend Investing engine for account %i (own adapter client ID, config, durable log)
After=ti-gateway.service
Wants=ti-gateway.service
# When this unit fails, ti-unit-failed@%n sends one urgent page through the
# reporter's channels naming it, its last journal line and the manual row to
# read (ADR 0019, "Alerting"; docs/manual/alerts-and-dashboard.md, "A failed
# unit").
OnFailure=ti-unit-failed@%n.service
# Skipped, not failed, until the stamped binary (deploy/build-engine.sh) and
# the account's configuration are installed. The IRA engines have no
# configuration yet.
ConditionFileIsExecutable=/opt/trend-investing/bin/ti-engine
ConditionPathExists=/etc/trend-investing/engines/%i.env
ConditionPathExists=/etc/trend-investing/engines/%i.config

[Service]
Type=simple
User=ti-trader
Group=ti-trader
Environment=TZ=America/New_York
# TI_MODE and the adapter client ID: repo-managed, per account.
EnvironmentFile=/etc/trend-investing/engines/%i.env
# TI_RUN, TI_AS_OF and TI_RESTART_ARGS: written by the owner before every
# start (docs/runbooks/durable-log.md, "Restarting an engine"). Required: a
# start without it fails, it does not guess.
EnvironmentFile=/var/lib/trend-investing/engines/%i/run.env
Environment=TI_CONFIG=/etc/trend-investing/engines/%i.config
Environment=TI_STATE_DIR=/var/lib/trend-investing/engines/%i
Environment=TI_DATA_DIR=/var/lib/trend-investing/data
Environment=TI_FLEX_DIR=/var/lib/trend-investing/flex/%i
LoadCredential=secrets:/etc/trend-investing/secrets.env
# The socket lives in a private directory, /run/ti-engine-%i, mode 0700,
# which transport.Listen requires of a socket's parent (ADR 0014).
RuntimeDirectory=ti-engine-%i
RuntimeDirectoryMode=0700
# The account's operator inbox, created by the provisioner inside the state
# directory, owned by ti-operator, the user that writes the owner's
# instructions, in the engine's group, mode 0750: the owner's kill switch and
# alert acknowledgements are read from it (ADR 0026, kill-switch amendment).
# The engine refuses to start if it is missing, if it could write it itself,
# or if it cannot read it (docs/manual/operator.md, "Who can write an
# instruction"); what it notes about each record goes in operator-notes/
# beside it, its own.
# The instance's Flex ledger, written by ti-flex@%i (the engine only reads
# it): its journalled deposits and withdrawals and the reader's status are
# delivered as inputs, so a transfer explains the cash it moved (ADR 0019,
# amended 2026-10-21; docs/manual/reconciliation.md). A ledger not yet
# written delivers nothing.
# Every setting is explicit. $TI_RESTART_ARGS is empty for a first run,
# "-approval <file>" for a fresh run after an earlier one, or
# "-resume <log>" after a crash; it expands to zero or more arguments.
ExecStart=/opt/trend-investing/bin/ti-engine -mode ${TI_MODE} -config ${TI_CONFIG} -socket %t/ti-engine-%i/engine.sock -log ${TI_STATE_DIR}/${TI_RUN}.log -out ${TI_STATE_DIR}/${TI_RUN}.journal -as-of ${TI_AS_OF} -operator ${TI_STATE_DIR}/operator -cash-ledger ${TI_FLEX_DIR}/cash-movements.jsonl $TI_RESTART_ARGS
# Never restarted by systemd: a crash is resumed, and any other restart is a
# fresh run the owner approves, both as an explicit step (owner decision
# 2026-10-16). SIGTERM stops it cleanly and writes its journal.
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trend-investing/engines/%i
ReadOnlyPaths=/var/lib/trend-investing/data
# The engine only reads its inbox, whatever its mode says.
ReadOnlyPaths=-/var/lib/trend-investing/engines/%i/operator
ReadOnlyPaths=-/var/lib/trend-investing/flex/%i
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
