[Unit]
Description=Reporter: daily summary, equity against SPY, alerts
After=ti-data.service
# PLACEHOLDER: binary not built yet.
ConditionFileIsExecutable=/opt/trend-investing/bin/ti-reporter

[Service]
Type=oneshot
User=ti-trader
Group=ti-trader
Environment=TZ=America/New_York
Environment=TI_STATE_ROOT=/var/lib/trend-investing
LoadCredential=secrets:/etc/trend-investing/secrets.env
ExecStart=/opt/trend-investing/bin/ti-reporter
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trend-investing/reports
ReadOnlyPaths=/var/lib/trend-investing/engines /var/lib/trend-investing/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
