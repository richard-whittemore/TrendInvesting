[Unit]
Description=Read-only dashboard (loopback only; published to the tailnet by tailscale serve)
After=network-online.target
# No Condition: a missing binary fails the unit with a message, so the owner
# sees a failed unit, never a silent skip.

[Service]
Type=simple
User=ti-trader
Group=ti-trader
Environment=TZ=America/New_York
# The page finds the engine's current run in its log directory on every
# request and follows the chain of runs back to the first, so a restart or an
# upgrade of the engine needs no restart of this unit (a new dashboard build
# does; docs/runbooks/lightsail-deployment.md).
# Loopback only, on the port `tailscale serve --bg 8088` publishes; the
# firewall also closes every non-Tailscale port. The dashboard needs no
# secret, so it is handed none.
# Every engine's folder is read (Boost, the Traditional IRA and the Roth IRA),
# each card with its own engine's state. An existing folder with no log and
# no run.env shows "no run yet: the engine has not started a run". A missing
# folder, or run.env without a journal, shows "journal unavailable".
# The Flex reader's ledger of each account's deposits and withdrawals (ti-flex@<instance>)
# is read on every request for the equity card's SPY shadow account; until
# the reader has written it the card says the comparison assumes none.
ExecStart=/opt/trend-investing/bin/ti-dashboard -engine-dir /var/lib/trend-investing/engines/boost -engine-dir /var/lib/trend-investing/engines/trad-ira -engine-dir /var/lib/trend-investing/engines/roth-ira -cash-ledger /var/lib/trend-investing/engines/boost=/var/lib/trend-investing/flex/boost/cash-movements.jsonl -cash-ledger /var/lib/trend-investing/engines/trad-ira=/var/lib/trend-investing/flex/trad-ira/cash-movements.jsonl -cash-ledger /var/lib/trend-investing/engines/roth-ira=/var/lib/trend-investing/flex/roth-ira/cash-movements.jsonl -addr 127.0.0.1:8088
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/trend-investing
# No instruction can come from this unit: it runs as ti-trader, the engine's
# user, and reads data from outside, so the operator inboxes are hidden from
# it, and nothing under the engines' state is writable (ProtectSystem=strict;
# ADR 0026, kill-switch amendment; docs/manual/server.md).
InaccessiblePaths=-/var/lib/trend-investing/engines/boost/operator -/var/lib/trend-investing/engines/trad-ira/operator -/var/lib/trend-investing/engines/roth-ira/operator
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
