[Unit]
Description=IBKR adapter for the Boost engine (sends only in paper, with paper_sending_enabled on)
After=ti-gateway.service ti-engine@boost.service
Wants=ti-gateway.service
# When this unit fails, ti-unit-failed@%n sends one urgent page through the
# reporter's channels naming it, the failed run's last journal line and the
# manual row to read (ADR 0019, "Alerting"; docs/manual/server.md, "A failed
# unit").
OnFailure=ti-unit-failed@%n.service
OnFailure=ti-gateway-heal@%n.service
# Skipped, not failed, until ibapi is installed and recorded (provision.sh
# twsapi), the adapter's code is installed (provision.sh adapter), and its
# configuration exists (provision.sh services creates it from the example).
ConditionFileIsExecutable=/opt/trend-investing/adapter-venv/bin/python3
ConditionPathExists=/opt/trend-investing/twsapi/INSTALLED
ConditionPathExists=/opt/trend-investing/adapter/adapter/ibkr/cli.py
ConditionPathExists=/etc/trend-investing/adapters/boost.json
# The secrets rest on disk only encrypted; ti-unlock decrypts them after
# each boot into a root-only tmpfs, and this unit loads its credential
# from there. Until then systemd refuses to start it ("Assertion failed")
# (ADR 0028; docs/manual/server.md, "Unlocking the
# secrets after a boot").
AssertPathExists=/run/trend-investing/secrets/accounts/boost.env

[Service]
Type=simple
User=ti-trader
Group=ti-trader
Environment=TZ=America/New_York
# TI_RUN names the engine's durable log, which the adapter reads: the same
# run file the engine starts from (docs/runbooks/durable-log.md). Start the
# engine first; the adapter refuses to start without its log.
EnvironmentFile=/var/lib/trend-investing/engines/boost/run.env
# The account number is read from the IBKR_ACCOUNT_BOOST line of this
# adapter's own root-only account file, handed to this service as a private
# copy; nothing else (no other account's number, no alert URL) is. The
# adapter's configuration names no account.
# --streams: the data job's Boost stream folders (ti-data.service writes
# ${TI_DATA_DIR}/streams/boost/${TI_RUN}/); the adapter delivers the run's
# own, <streams>/${TI_RUN}, the run its --engine-log names, or after a crash
# resume (a new TI_RUN carrying the crashed run's identity) the folder of
# the run that began it, as the data job finds it. It refuses to start
# until that folder exists: run the data job's warm-up first
# (docs/manual/market-data.md, "The one-time warm-up", "A crash resume").
# --cash-ledger: the Flex reader's Boost ledger (ti-flex@boost), read only;
# its journalled deposits and withdrawals are subtracted from the cash since
# the previous close before the 1% drift bound (ADR 0019, amended
# 2026-10-21).
LoadCredential=account:/run/trend-investing/secrets/accounts/boost.env
WorkingDirectory=/opt/trend-investing/adapter
ExecStart=/opt/trend-investing/adapter-venv/bin/python3 -m adapter.ibkr run --config /etc/trend-investing/adapters/boost.json --secrets %d/account --account-key IBKR_ACCOUNT_BOOST --pending /var/lib/trend-investing/adapters/boost/pending.json --engine-log /var/lib/trend-investing/engines/boost/${TI_RUN}.log --socket /run/ti-engine-boost/engine.sock --streams /var/lib/trend-investing/data/streams/boost --cash-ledger /var/lib/trend-investing/flex/boost/cash-movements.jsonl --ibapi-record /opt/trend-investing/twsapi/INSTALLED --versions /opt/trend-investing/adapter/versions.env
# To veto recovery of a failed unit, reset-failed it or stop its healer
# (docs/manual/server.md, Gateway healer). Only the exit-3 Gateway remedy can
# start this adapter through the bounded healer (docs/manual/server.md,
# Gateway healer; ADR 0025). SIGTERM stops it cleanly.
Restart=no
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trend-investing/adapters/boost
ReadOnlyPaths=/var/lib/trend-investing/engines/boost -/var/lib/trend-investing/data/streams/boost -/var/lib/trend-investing/flex/boost
# No instruction can come from this unit: it runs as ti-trader, the engine's
# user, and reads data from outside, so the operator inboxes are hidden from
# it, and nothing under the engines' state is writable (ProtectSystem=strict;
# ADR 0026, kill-switch amendment; docs/manual/server.md).
InaccessiblePaths=-/var/lib/trend-investing/engines/boost/operator -/var/lib/trend-investing/engines/trad-ira/operator -/var/lib/trend-investing/engines/roth-ira/operator
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
