[Unit]
Description=Run the Boost account's Flex reader after the US close on weekdays

[Timer]
# 21:30 New York, weekdays: after the close (4 p.m.) and the evening's data
# step (ti-data.timer, last firing 20:05). IBKR may post a day's transfer to
# the Flex statement only after its own end-of-day processing, so a transfer
# missing from one evening's statement is read the next: the owner's Flex
# query covers several days (docs/manual/reconciliation.md), and a transfer
# already in the ledger is never written again. Persistent: a run missed
# while the server was down runs at boot. Enabled by the owner once the
# token and query ID are in secrets.env (docs/runbooks/lightsail-deployment.md).
OnCalendar=Mon..Fri 21:30 America/New_York
Persistent=true
Unit=ti-flex-boost.service

[Install]
WantedBy=timers.target
