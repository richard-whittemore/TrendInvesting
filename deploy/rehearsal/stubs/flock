#!/usr/bin/env python3
# A stand-in for util-linux flock(1) on a machine that has none (the tests run
# on a Mac): `flock [-w SECONDS] FD` takes an exclusive lock on the already open
# descriptor FD, waiting at most SECONDS, and exits 1 if it could not. The lock
# belongs to the open file description, so it lasts as long as the caller
# keeps FD open, as with the real tool.
import fcntl
import sys
import time

args = sys.argv[1:]
wait = None
if args and args[0] == "-w":
    wait = float(args[1])
    args = args[2:]
fd = int(args[0])
end = time.time() + (wait if wait is not None else 1e9)
while True:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        sys.exit(0)
    except BlockingIOError:
        if time.time() >= end:
            sys.exit(1)
        time.sleep(0.05)
