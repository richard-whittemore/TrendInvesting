<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The alert triage job (docs/manual/alerts-and-dashboard.md, "Alerts analysed
  by Claude"; setup: docs/runbooks/mac-mini.md, "2. The alert triage job").
  A LaunchDaemon run as the macOS user ti-triage, which holds no SSH key, no
  gh login and no keychain entry for GitHub. One poll per firing, every five
  minutes; launchd never starts a firing while the last still runs. The token
  is named by file, never written here. Replace <server>.<tailnet> with the
  Lightsail server's tailnet name before installing.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.trendinvesting.triage</string>
	<key>UserName</key>
	<string>ti-triage</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/ti-triage/bin/ti-triage</string>
		<string>-repo</string>
		<string>richard-whittemore/TrendInvesting</string>
		<string>-repo-dir</string>
		<string>/Users/ti-triage/TrendInvesting-triage</string>
		<string>-state-dir</string>
		<string>/Users/ti-triage/triage</string>
		<string>-token-file</string>
		<string>/Users/ti-triage/.config/ti-triage/github-token</string>
		<string>-claude-token-file</string>
		<string>/Users/ti-triage/.config/ti-triage/claude-token</string>
		<string>-slice-url</string>
		<string>https://&lt;server&gt;.&lt;tailnet&gt;.ts.net/api/journal-slice</string>
		<string>-daily-cap</string>
		<string>10</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/ti-triage/bin:/Users/ti-triage/.local/bin:/usr/local/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>HOME</key>
		<string>/Users/ti-triage</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/ti-triage</string>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/ti-triage/triage/triage.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/ti-triage/triage/triage.log</string>
</dict>
</plist>
