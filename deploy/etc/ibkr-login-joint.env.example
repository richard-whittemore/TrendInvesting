# /etc/trend-investing/ibkr-login-joint.env  (root:root, mode 0600, outside the repository)
# OWNER STEP: enter the IBKR login here, on the server, by hand. Agents never do.
# Read when selected, staged by ti-gateway.service's root pre-start as login.env
# in the Gateway runtime directory (ADR 0028; docs/runbooks/gateway-login.md).
# IBC's config.ini is rendered into tmpfs. Engines never see this file.
TWS_USERID=
TWS_PASSWORD=
# The joint selection requires paper mode (docs/runbooks/gateway-login.md).
TWS_TRADING_MODE=paper
# yes until the limited-live gate; the adapter cannot place orders while yes.
TWS_READONLY_API=yes
