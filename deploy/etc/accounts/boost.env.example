# /etc/trend-investing/accounts/boost.env  (root:root, mode 0600, outside the repository)
# The Boost account's IBKR account number, alone: the only file the Boost
# adapter is handed (systemd LoadCredential, ti-adapter-boost.service), read
# from $CREDENTIALS_DIRECTORY/account. Names only here; the owner fills the
# value on the server as KEY=VALUE, with no quotes and no spaces.
IBKR_ACCOUNT_BOOST=
