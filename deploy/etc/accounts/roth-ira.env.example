# /etc/trend-investing/accounts/roth-ira.env  (root:root, mode 0600, outside the repository)
# The Roth IRA account's IBKR account number, alone: the file its Flex reader is
# handed (systemd LoadCredential, ti-flex@roth-ira.service), read from
# $CREDENTIALS_DIRECTORY/account. Names only here; the owner fills the value
# on the server as KEY=VALUE, with no quotes and no spaces. Left empty, the
# reader refuses it, naming this line, and its unit fails.
IBKR_ACCOUNT_ROTH_IRA=
