# /etc/trend-investing/ibkr-login.env  (root:root, mode 0600, outside the repository)
# OWNER STEP: enter the IBKR login here, on the server, by hand. Agents never do.
# Read only by ti-gateway.service (through systemd LoadCredential), which renders
# IBC's config.ini into a tmpfs. Engines never see this file.
TWS_USERID=
TWS_PASSWORD=
# paper until the limited-live gate (AGENTS.md rule 5); only "paper" or "live".
TWS_TRADING_MODE=paper
# yes until the limited-live gate; the adapter cannot place orders while yes.
TWS_READONLY_API=yes
