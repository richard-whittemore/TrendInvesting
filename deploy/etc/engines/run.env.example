# One engine start, written by the owner to
# /var/lib/trend-investing/engines/<account>/run.env before every start
# (docs/runbooks/durable-log.md, "Restarting an engine"). Example values.
#
# TI_RUN names this run's durable log and journal in the state directory:
# <TI_RUN>.log and <TI_RUN>.journal. It must be new; a log is never reused.
TI_RUN=run-2026-10-20
# TI_AS_OF is the run's declared start, RFC 3339: sessions closing before it
# only warm the indicators. A resumed run keeps the crashed run's value.
TI_AS_OF=2026-10-20T20:00:00Z
# Empty for the first run. A fresh run after an earlier one:
#   TI_RESTART_ARGS=-approval /var/lib/trend-investing/engines/<account>/approval-<TI_RUN>.json
# After a crash only:
#   TI_RESTART_ARGS=-resume /var/lib/trend-investing/engines/<account>/<crashed run>.log
TI_RESTART_ARGS=
