# Non-secret per-account settings. Each engine has its own adapter client ID on
# the one IB Gateway (ADR 0026 section 8); IDs must be unique across the server.
TI_ACCOUNT=boost
TI_ADAPTER_CLIENT_ID=11
# The engine's -mode. It must equal the mode in boost.config, which is hashed
# with the configuration; dry-run until the paper gate (AGENTS.md rule 5).
TI_MODE=dry-run
