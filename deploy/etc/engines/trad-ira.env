# Non-secret per-account settings: the adapter client ID, unique across the
# server (ADR 0026 section 8), and the engine's mode.
TI_ACCOUNT=trad-ira
TI_ADAPTER_CLIENT_ID=12
# The line of the account's own file (/etc/trend-investing/accounts/trad-ira.env)
# that names its IBKR account, which ti-adapter@trad-ira reads; the name only.
TI_ADAPTER_ACCOUNT_KEY=IBKR_ACCOUNT_TRAD_IRA
# The engine's -mode. It must equal the mode in the account's configuration,
# which is hashed with it; dry-run until the paper gate (AGENTS.md rule 5).
TI_MODE=dry-run
