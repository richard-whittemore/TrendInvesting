# /etc/trend-investing/secrets.env  (root:root, mode 0600, outside the repository)
# Names only; the owner fills in the values on the server. The file is
# encrypted at rest (ADR 0028): edit it only with `sudo ti-secrets edit
# secrets.env`. Put each value straight after `=`, with no quotes and no
# spaces. Never put the IBKR login here; it lives in ibkr-login.env.
# The data job, the engines, the reporter and the Flex readers are each handed
# this file as a private credential; the dashboard is given none.
# Where each name is explained: docs/manual/server.md, "Where the secrets live".

# Market data. Read only by the data job, and only MASSIVE_API_KEY from this
# file. Your own key from massive.com; never committed, never printed.
MASSIVE_API_KEY=

# Daily summary, on your own ntfy server. Read by the reporter. The summary
# carries balances, so it goes only to your own server: never to the public
# relay, never to Pushover. Without your own server it is not sent.
# TI_NTFY_SERVER: your server's URL, http://<this server's Tailscale
# address>:2586, as `provision.sh ntfy` prints it. Empty means the public
# https://ntfy.sh relay, which alerts use and the summary never does.
# TI_NTFY_TOPIC: an unguessable topic name; it is the ntfy secret.
TI_NTFY_TOPIC=
TI_NTFY_SERVER=

# Urgent pages, through Pushover (docs/manual/server.md, "The pager").
# Both values are secrets. While either is empty the reporter sets the
# Pushover channel aside; ntfy still delivers (the reporter's unit names only
# the ntfy and pushover channels), and the reporter's unit exits non-zero.
# TI_PUSHOVER_APP_TOKEN: the API token of the application "Trend server".
# TI_PUSHOVER_USER_KEY: your Pushover user key.
TI_PUSHOVER_APP_TOKEN=
TI_PUSHOVER_USER_KEY=

# Outside heartbeat (docs/manual/server.md, "The outside heartbeat").
# TI_HEARTBEAT_URL: the ping address of your check at Healthchecks,
# https://hc-ping.com/<uuid>. A secret. The reporter pings it at the end of
# each firing that finishes with no fault and with no trading unit failed, and
# the service pages you through Pushover when the pings stop. Empty means no
# ping is sent.
TI_HEARTBEAT_URL=

# Alerts as GitHub issues (docs/manual/alerts-and-dashboard.md, "Alerts as
# GitHub Issues"). The reporter's unit and the failed-unit hook name the
# github-issues channel, so these two values are read at every firing. While
# either is empty the channel is set aside: ntfy and Pushover still deliver,
# the run says which value is missing, and the unit exits non-zero.
# TI_GITHUB_ISSUES_TOKEN: a fine-grained token with Issues read and write on
# that one repository and no other permission. A secret.
# TI_GITHUB_ISSUES_REPO: the private alerts repository as owner/name.
TI_GITHUB_ISSUES_TOKEN=
TI_GITHUB_ISSUES_REPO=

# Filled in later.
# TI_IBKR_FLEX_TOKEN: the Flex Web Service token from IBKR Client Portal. A
# secret, sent only to IBKR. TI_IBKR_FLEX_QUERY_ID: the ID of your saved Flex
# query holding the Cash Transactions section. The Flex reader refuses to run
# while either is empty (docs/manual/reconciliation.md, "Deposits and
# withdrawals, read from IBKR").
# IBKR_ACCOUNT_TRAD_IRA and IBKR_ACCOUNT_ROTH_IRA: no program reads them yet.
# Each Flex reader reads its own account file, accounts/<account>.env. The
# Boost account's number lives in accounts/boost.env
# (deploy/etc/accounts/boost.env.example), the only file its adapter is given.
TI_IBKR_FLEX_TOKEN=
TI_IBKR_FLEX_QUERY_ID=
IBKR_ACCOUNT_TRAD_IRA=
IBKR_ACCOUNT_ROTH_IRA=

# Unused. TI_PAGERDUTY_ROUTING_KEY is the PagerDuty Events API v2 key of the
# optional pagerduty channel; the server's units do not name that channel.
# Leave it empty.
TI_PAGERDUTY_ROUTING_KEY=
