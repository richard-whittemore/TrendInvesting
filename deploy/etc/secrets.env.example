# /etc/trend-investing/secrets.env  (root:root, mode 0600, outside the repository)
# Names only; the owner fills the values on the server. Passed to the data step,
# engines, reporter and dashboard through systemd LoadCredential and read by them
# from $CREDENTIALS_DIRECTORY/secrets. Never put the IBKR login here.
# IBKR account numbers (each engine reads only its own).
IBKR_ACCOUNT_BOOST=
IBKR_ACCOUNT_TRAD_IRA=
IBKR_ACCOUNT_ROTH_IRA=
# Alerting (plan.md section 7).
NTFY_URL=
HEALTHCHECK_URL=
