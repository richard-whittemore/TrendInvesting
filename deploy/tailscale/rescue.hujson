// Rescue policy for a locked-out server. Paste it into the admin console's
// Access controls page when `ssh ubuntu@trend-investing-1` stops working after
// the server was tagged (docs/manual/server.md, "Closing the Gateway's ports
// to your other devices"). It restores SSH and nothing else: its grants are
// policy.hujson's exactly, so the Gateway's API ports (4001, 4002) stay closed,
// and the Mac mini keeps its dashboard access. The only difference from
// policy.hujson's server SSH rule is that this rescue also allows root. Paste
// policy.hujson again once the cause is fixed.
{
	"tagOwners": {
		"tag:trend-server":   ["autogroup:admin"],
		"tag:trend-mac-mini": ["autogroup:admin"],
	},

	"grants": [
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:trend-server"],
			"ip":  ["tcp:22", "tcp:443", "tcp:2586"],
		},
		{
			"src": ["tag:trend-mac-mini"],
			"dst": ["tag:trend-server"],
			"ip":  ["tcp:443"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["tag:trend-mac-mini"],
			"ip":  ["*"],
		},
	],

	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["tag:trend-server"],
			"users":  ["ubuntu", "root"],
		},
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["tag:trend-mac-mini"],
			"users":  ["autogroup:nonroot"],
		},
	],
}
